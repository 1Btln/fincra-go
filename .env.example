# Optional environment fallback for fincra.New and fincra.ConfigFromEnv. Prefer
# building a fincra.Config and passing it to fincra.NewWithConfig.
#
# Sandbox and live keys are different and mutually invalid. Never commit real
# keys.
FINCRA_SECRET_KEY=
FINCRA_PUBLIC_KEY=
FINCRA_WEBHOOK_SECRET=
FINCRA_BUSINESS_ID=

# "sandbox" (default) or "live".
FINCRA_ENVIRONMENT=sandbox

# Optional overrides.
# FINCRA_BASE_URL=
# FINCRA_TIMEOUT=30s
# FINCRA_MAX_RETRIES=2
